{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --once && node setup.mjs && npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "dev:docker": "npm-run-all --parallel dev:docker:frontend dev:docker:backend",
    "dev:docker:frontend": "VITE_CONVEX_URL=https://convex.grayhux.io vite --open",
    "dev:docker:backend": "convex dev --local --env-file .env.docker",
    "build": "vite build",
    "build:docker": "VITE_CONVEX_URL=https://convex.grayhux.io vite build",
    "build:cloud": "VITE_CONVEX_URL=https://whimsical-hamster-488.convex.cloud vite build",
    "build:prod": "VITE_CONVEX_URL=https://hushed-scorpion-51.convex.cloud vite build",
    "preview": "vite preview",
    "preview:docker": "npm run build:docker && vite preview",
    "preview:cloud": "npm run build:cloud && vite preview",
    "preview:prod": "npm run build:prod && vite preview",
    "deploy:convex:local": "convex deploy --env-file .env.docker",
    "deploy:convex:cloud": "CONVEX_DEPLOYMENT=whimsical-hamster-488 convex deploy",
    "deploy:vercel": "vercel deploy --prod",
    "deploy": "npm run deploy:convex:cloud && npm run deploy:vercel",
    "dev:cloud": "npm-run-all --parallel dev:cloud:frontend dev:cloud:backend",
    "dev:cloud:frontend": "VITE_CONVEX_URL=https://whimsical-hamster-488.convex.cloud vite --open",
    "dev:cloud:backend": "CONVEX_DEPLOYMENT=whimsical-hamster-488 convex dev",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && convex dev --once && vite build"
  },
  "dependencies": {
    "@convex-dev/auth": "0.0.86",
    "@headlessui/react": "^2.2.3",
    "@heroicons/react": "^2.2.0",
    "convex": "1.24.1",
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@shadcn/ui": "^0.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "lucide-react": "^0.511.0",
    "npm-run-all": "^4.1.5",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "tailwindcss": "~3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
