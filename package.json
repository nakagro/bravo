{
  "name": "bravo",
  "private": true,
  "version": "2026.07.03",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:vps:frontend",
    "dev:frontend": "npm run dev:vps:frontend",
    "dev:vps": "npm run dev:vps:frontend",
    "dev:vps:frontend": "vite --open --mode vps",
    "dev:cloud": "npm-run-all --parallel dev:cloud:frontend dev:cloud:backend",
    "dev:cloud:frontend": "vite --open --mode cloud",
    "dev:cloud:backend": "CONVEX_DEPLOYMENT=precious-magpie-647 convex dev",
    "build": "npm run build:vps",
    "build:vps": "vite build --mode vps",
    "build:cloud": "vite build --mode cloud",
    "preview": "vite preview",
    "preview:vps": "npm run build:vps && vite preview",
    "preview:cloud": "npm run build:cloud && vite preview",
    "deploy:convex:vps": "convex deploy --env-file .env.vps",
    "deploy:vps": "npm run deploy:convex:vps",
    "deploy:convex:cloud": "CONVEX_DEPLOYMENT=precious-magpie-647 convex dev --once",
    "export:vps": "convex export --env-file .env.vps --path ./exports/convex/vps-export-$(date +%Y%m%d-%H%M%S).zip",
    "import:vps": "convex import --env-file .env.vps --replace-all",
    "import:cloud": "CONVEX_DEPLOYMENT=precious-magpie-647 convex import --replace-all",
    "seed:cloud": "CONVEX_DEPLOYMENT=precious-magpie-647 npx convex run seed:seedDevDatabase",
    "keys:generate": "node scripts/generate-keys.mjs",
    "serve:dist": "node scripts/serve-app.js",
    "test:api-key": "bash scripts/test-api-key.sh",
    "version:sync": "node scripts/set-build-version.js",
    "typecheck": "tsc -p convex --noEmit --pretty false && tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "lint": "npm run typecheck && convex dev --once && vite build",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "0.0.91",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hcaptcha/react-hcaptcha": "^1.12.0",
    "@headlessui/react": "^2.2.3",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@marsidev/react-turnstile": "^1.2.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@types/qrcode": "^1.5.6",
    "browser-image-compression": "^2.0.2",
    "cmdk": "^1.1.1",
    "convex": "^1.41.0",
    "date-fns": "^4.1.0",
    "ical-expander": "^3.1.0",
    "ical.js": "^2.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.270.1",
    "posthog-node": "^5.9.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.2",
    "react-simple-keyboard": "^3.8.221",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.1.2",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.1.0",
    "tsdav": "^2.1.5",
    "vaul": "^1.1.2",
