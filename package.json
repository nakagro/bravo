    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@types/qrcode": "^1.5.6",
    "browser-image-compression": "^2.0.2",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "date-fns": "^4.4.0",
    "ical-expander": "^3.1.0",
    "ical.js": "^2.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.399.1",
    "posthog-node": "^5.40.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-simple-keyboard": "^3.8.233",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "sonner": "^2.0.6",
