{
  "name": "bravo",
  "private": true,
  "version": "2026.09.23",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:vps:frontend",
    "dev:frontend": "npm run dev:vps:frontend",
    "dev:vps": "npm run dev:vps:frontend",
    "dev:vps:frontend": "vp dev --open --mode vps",
    "dev:cloud": "node scripts/renamed-script.mjs dev:cloud dev:uat",
    "dev:uat:frontend": "vp dev --open --mode cloud",
    "dev:uat:backend": "echo '' && echo '  convex dev WATCH LOOP -> precious-magpie-647 (UAT)' && echo '  Every save republishes your working copy. Do not run during a verification pass.' && echo '' && CONVEX_DEPLOYMENT=precious-magpie-647 convex dev",
    "build": "npm run build:vps",
    "build:vps": "vp build --mode vps && npm run check:no-em-dashes",
    "build:cloud": "vp build --mode cloud && npm run check:no-em-dashes",
    "preview": "vp preview",
    "preview:vps": "npm run build:vps && vp preview",
    "preview:cloud": "npm run build:cloud && vp preview",
    "deploy:convex:vps": "bash scripts/guard-prod.sh \"Convex backend deploy\" && convex deploy --env-file .env.vps",
    "deploy:vps": "npm run deploy:convex:vps",
    "codegen:convex:vps": "CONVEX_DEPLOYMENT= CI=1 node --env-file=.env.vps node_modules/convex/bin/main.js codegen",
    "deploy:convex:cloud": "node scripts/renamed-script.mjs deploy:convex:cloud deploy:convex:uat",
    "export:vps": "convex export --env-file .env.vps --include-file-storage --path ./exports/convex/vps-export-$(date +%Y%m%d-%H%M%S).zip",
    "import:vps": "bash scripts/guard-prod.sh \"Convex import --replace-all (WIPES prod data)\" && convex import --env-file .env.vps --replace-all",
    "backup:vps": "./scripts/backup-convex-vps.sh",
    "backup:verify": "./scripts/verify-convex-backup.py --all",
    "backup:drill": "./scripts/restore-drill-convex.sh",
    "import:uat": "CONVEX_DEPLOYMENT=precious-magpie-647 convex import --replace-all",
    "import:cloud": "node scripts/renamed-script.mjs import:cloud import:uat",
    "seed:uat": "CONVEX_DEPLOYMENT=precious-magpie-647 npx convex run seed:seedDevDatabase",
    "seed:cloud": "node scripts/renamed-script.mjs seed:cloud seed:uat",
    "clone:uat": "bash scripts/clone-prod-to-uat.sh",
    "snapshot:prod": "bash scripts/snapshot-prod.sh",
    "env:parity": "node scripts/check-env-parity.mjs",
    "refresh:uat": "npm run env:parity && npm run clone:uat -- --yes && npm run deploy:convex:uat",
    "sync:uat": "bash scripts/sync-uat-branch.sh",
    "release:prod": "npm run snapshot:prod && npm run deploy:convex:vps",
    "keys:generate": "node scripts/generate-keys.mjs",
    "serve:dist": "node scripts/serve-app.js",
    "test:api-key": "bash scripts/test-api-key.sh",
    "check:no-em-dashes": "node scripts/check-no-em-dashes.mjs",
    "docs:index": "node scripts/docs-index.mjs",
    "convex:versions": "node scripts/convex-version-map.mjs",
    "version:sync": "node scripts/set-build-version.js",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint:code": "vp lint",
    "typecheck": "tsc -p convex --noEmit --pretty false && tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "lint": "vp lint && npm run typecheck && vp test run && npm run codegen:convex:uat && vp build && npm run check:no-em-dashes",
    "prepare": "husky",
    "skills:sync": "bash scripts/sync-agent-skills.sh",
    "skills:prune": "SKIP_UPDATE=1 bash scripts/sync-agent-skills.sh",
    "codegen:convex:uat": "CONVEX_DEPLOYMENT=precious-magpie-647 CI=1 npx convex codegen",
    "codegen:convex:cloud": "node scripts/renamed-script.mjs codegen:convex:cloud codegen:convex:uat",
    "deploy:convex:uat": "echo '' && echo '  Deploying backend -> precious-magpie-647 (UAT)' && echo '' && CONVEX_DEPLOYMENT=precious-magpie-647 convex dev --once",
    "dev:uat": "npm-run-all --parallel dev:uat:frontend dev:uat:backend"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@convex-dev/auth": "^0.0.94",
    "@daypicker/react": "^10.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@types/qrcode": "^1.5.6",
    "browser-image-compression": "^2.0.2",
    "cmdk": "^1.1.1",
    "convex": "^1.44.0",
    "date-fns": "^4.4.0",
    "ical-expander": "^3.1.0",
    "ical.js": "^2.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.399.1",
    "posthog-node": "^5.40.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-simple-keyboard": "^3.8.233",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.6.0",
    "tsdav": "^2.3.1",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex-test": "^0.0.54",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lucide-react": "^1.24.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  }
}
