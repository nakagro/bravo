import React, { useState, useEffect } from 'react';
import { createDAVClient } from 'tsdav';
import { CalendarIcon, ClockIcon } from '@heroicons/react/24/outline';
import { format, isAfter, startOfDay } from 'date-fns';

interface CalendarEvent {
  uid: string;
  summary: string;
  start: Date;
  end: Date;
  description?: string;
  location?: string;
  rrule?: string;
  tzid?: string;
  allDay?: boolean;
}

interface CalDAVCalendarProps {
  calendarUrl: string;
  maxEvents?: number;
  username?: string;
  password?: string;
}

export function CalDAVCalendar({ calendarUrl, maxEvents = 5, username, password }: CalDAVCalendarProps) {
  const [events, setEvents] = useState<CalendarEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Parse ICS date/time considering TZID and VALUE=DATE
  const parseICalDate = (key: string, value: string): { date?: Date; allDay?: boolean; tzid?: string } => {
    try {
      const tzidMatch = key.match(/TZID=([^;:]+)/);
      const tzid = tzidMatch ? tzidMatch[1] : undefined;
      const isDateOnly = /VALUE=DATE/.test(key);

      // YYYYMMDD or YYYYMMDDTHHMMSS(Z?)
      const y = Number(value.slice(0, 4));
      const m = Number(value.slice(4, 6));
      const d = Number(value.slice(6, 8));

      if (isDateOnly || value.length === 8) {
        // All-day event, interpret as local midnight
        return { date: new Date(y, m - 1, d, 0, 0, 0), allDay: true, tzid };
      }

      const hasTime = value.length >= 15; // includes time part
      const endsWithZ = value.endsWith('Z');
      const hh = Number(value.slice(9, 11));
      const mm = Number(value.slice(11, 13));
      const ss = Number(value.slice(13, 15));

      if (endsWithZ) {
        // UTC time
        const iso = `${y.toString().padStart(4, '0')}-${m.toString().padStart(2, '0')}-${d
          .toString()
          .padStart(2, '0')}T${hh.toString().padStart(2, '0')}:${mm
          .toString()
          .padStart(2, '0')}:${ss.toString().padStart(2, '0')}Z`;
        return { date: new Date(iso), allDay: false, tzid };
      }

      // No trailing Z: treat as local time (sufficient for single-timezone usage)
      return { date: new Date(y, m - 1, d, hh, mm, ss), allDay: false, tzid };
    } catch (e) {
      console.error('Error parsing iCal date:', key, value, e);
      return { date: undefined };
    }
  };

  // Helpers for RRULE expansion (supports common MONTHLY BYDAY rules)
  const weekdayMap: Record<string, number> = {
    SU: 0,
    MO: 1,
    TU: 2,
    WE: 3,
    TH: 4,
    FR: 5,
    SA: 6,
  };

  const getNthWeekdayOfMonth = (year: number, monthIndex0: number, weekday: number, n: number): Date | null => {
    // monthIndex0: 0-11
    const firstOfMonth = new Date(year, monthIndex0, 1);
    const firstDow = firstOfMonth.getDay(); // 0-6
    const delta = (weekday - firstDow + 7) % 7;
    const day = 1 + delta + 7 * (n - 1);
    const result = new Date(year, monthIndex0, day);
    if (result.getMonth() !== monthIndex0) return null;
    return result;
  };

  const parseRRule = (rrule: string): { freq?: string; byday?: string[]; until?: Date } => {
    const parts = rrule.split(';');
    const out: { freq?: string; byday?: string[]; until?: Date } = {};
    for (const p of parts) {
      const [k, v] = p.split('=');
      if (!k || !v) continue;
      const keyU = k.toUpperCase();
      if (keyU === 'FREQ') out.freq = v.toUpperCase();
      if (keyU === 'BYDAY') out.byday = v.split(',').map((s) => s.toUpperCase());
      if (keyU === 'UNTIL') {
        // UNTIL can be UTC (ends with Z) or local-like, treat via Date parsing
        const parsed = parseICalDate('UNTIL', v);
        if (parsed.date) out.until = parsed.date;
      }
    }
    return out;
  };

  const expandRecurringEvents = (baseEvents: CalendarEvent[], fromDate: Date, monthsAhead = 12): CalendarEvent[] => {
    const results: CalendarEvent[] = [];
    for (const ev of baseEvents) {
      if (!ev.rrule) {
        results.push(ev);
        continue;
      }
      const rule = parseRRule(ev.rrule);
      if (rule.freq !== 'MONTHLY' || !rule.byday || rule.byday.length === 0 || !ev.start) {
        // Unsupported rule; include the original DTSTART occurrence if in the future
        results.push(ev);
        continue;
      }

      const durationMs = ev.end && ev.start ? ev.end.getTime() - ev.start.getTime() : 0;
      const startHour = ev.start.getHours();
      const startMin = ev.start.getMinutes();
      const startSec = ev.start.getSeconds();

      // Iterate months from current through lookahead
      const startCursor = new Date(fromDate.getFullYear(), fromDate.getMonth(), 1);
      for (let i = 0; i <= monthsAhead; i++) {
        const y = startCursor.getFullYear();
        const m0 = startCursor.getMonth();
        for (const token of rule.byday) {
          // token like 3SU or 1TU or 5TU
          const match = token.match(/(-?\d)?(SU|MO|TU|WE|TH|FR|SA)/);
          if (!match) continue;
          const ordStr = match[1];
          const dowStr = match[2];
          const dow = weekdayMap[dowStr];
          const ordinals = ordStr ? [Number(ordStr)] : []; // Only ordinal form supported here
          if (ordinals.length === 0) continue; // we expect ordinals in this feed

          for (const n of ordinals) {
            const dateCandidate = getNthWeekdayOfMonth(y, m0, dow, n);
            if (!dateCandidate) continue;

            // Set time-of-day from original DTSTART (or keep midnight for all-day)
            if (!ev.allDay) {
              dateCandidate.setHours(startHour, startMin, startSec, 0);
            } else {
              dateCandidate.setHours(0, 0, 0, 0);
            }

            // Respect DTSTART baseline and UNTIL
            if (dateCandidate < ev.start) continue;
            if (rule.until && dateCandidate > rule.until) continue;

            const newStart = new Date(dateCandidate);
            const newEnd = durationMs ? new Date(newStart.getTime() + durationMs) : new Date(newStart);
            results.push({ ...ev, start: newStart, end: newEnd });
          }
        }
        // advance a month
        startCursor.setMonth(startCursor.getMonth() + 1);
      }
    }
    return results;
  };

  const parseICSEvent = (icsData: string): CalendarEvent[] => {
    const events: CalendarEvent[] = [];
    const lines = icsData.split('\n').map(line => line.trim());
    
    let currentEvent: Partial<CalendarEvent> = {};
    let inEvent = false;
    
    for (const line of lines) {
      if (line === 'BEGIN:VEVENT') {
        inEvent = true;
        currentEvent = {};
      } else if (line === 'END:VEVENT' && inEvent) {
        if (currentEvent.uid && currentEvent.summary && currentEvent.start) {
          events.push(currentEvent as CalendarEvent);
        }
        inEvent = false;
      } else if (inEvent) {
        const [key, ...valueParts] = line.split(':');
        const value = valueParts.join(':');
        
        switch (key) {
          case 'UID':
            currentEvent.uid = value;
            break;
          case 'SUMMARY':
            currentEvent.summary = value;
            break;
          case 'DESCRIPTION':
            currentEvent.description = value;
            break;
          case 'LOCATION':
            currentEvent.location = value;
            break;
          default:
            // Handle DTSTART / DTEND with parameters (e.g., TZID, VALUE=DATE)
            if (key.startsWith('DTSTART')) {
              const parsed = parseICalDate(key, value);
              if (parsed.date) currentEvent.start = parsed.date;
              if (parsed.tzid) currentEvent.tzid = parsed.tzid;
              if (parsed.allDay) currentEvent.allDay = true;
            } else if (key.startsWith('DTEND')) {
              const parsed = parseICalDate(key, value);
              if (parsed.date) currentEvent.end = parsed.date;
            } else if (key === 'RRULE') {
              currentEvent.rrule = value;
            }
            break;
        }
      }
    }
    
    return events;
  };

  const fetchCalendarEvents = async () => {
    try {
      setLoading(true);
      setError(null);

      // Use Convex proxy endpoint to avoid CORS issues
      const convexUrl = import.meta.env.VITE_CONVEX_URL || 'http://localhost:3210';
      let proxyUrl = `${convexUrl}/http/calendar/events?url=${encodeURIComponent(calendarUrl)}`;
      
      // Add authentication parameters if provided
      if (username && password) {
        proxyUrl += `&username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`;
      }
      
      const response = await fetch(proxyUrl, {
        headers: {
          'Accept': 'text/calendar',
        },
      });

      if (!response.ok) {
        throw new Error(`Failed to fetch calendar: ${response.status} ${response.statusText}`);
      }

      const icsData = await response.text();
      const parsedEvents = parseICSEvent(icsData);
      
      // Expand recurring events (e.g., MONTHLY BYDAY) and filter future occurrences
      const now = new Date();
      const expanded = expandRecurringEvents(parsedEvents, now, 12);
      const todayStart = startOfDay(now).getTime();
      const tomorrowStart = startOfDay(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1)).getTime();
      const upcomingEvents = expanded
        .filter(event => {
          if (!event.start) return false;
          const t = event.start.getTime();
          if (isAfter(event.start, now)) return true;
          // Include ongoing all-day events for the rest of today
          if (event.allDay && t >= todayStart && t < tomorrowStart) return true;
          return false;
        })
        .sort((a, b) => a.start.getTime() - b.start.getTime())
        .slice(0, maxEvents);

      setEvents(upcomingEvents);
    } catch (err) {
      console.error('Error fetching calendar events:', err);
      setError(err instanceof Error ? err.message : 'Failed to fetch calendar events');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchCalendarEvents();
    
    // Refresh events every 30 minutes
    const interval = setInterval(fetchCalendarEvents, 30 * 60 * 1000);
    return () => clearInterval(interval);
  }, [calendarUrl, maxEvents]);

  const formatEventDate = (date: Date) => {
    const now = new Date();
    const today = startOfDay(now);
    const eventDate = startOfDay(date);
    
    if (eventDate.getTime() === today.getTime()) {
      return `Today at ${format(date, 'h:mm a')}`;
    } else if (eventDate.getTime() === today.getTime() + 24 * 60 * 60 * 1000) {
      return `Tomorrow at ${format(date, 'h:mm a')}`;
    } else {
      return format(date, 'MMM d, yyyy \'at\' h:mm a');
    }
  };

  if (loading) {
    return (
      <div className="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 transition-colors duration-200">
        <div className="flex items-center mb-4">
          <CalendarIcon className="h-6 w-6 text-purple-600 dark:text-purple-400 mr-2" />
          <h2 className="text-xl font-semibold text-gray-800 dark:text-gray-200">Upcoming Events</h2>
        </div>
        <div className="flex items-center justify-center py-8">
          <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600 dark:border-purple-400"></div>
          <span className="ml-3 text-gray-600 dark:text-gray-400">Loading events...</span>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 transition-colors duration-200">
        <div className="flex items-center mb-4">
          <CalendarIcon className="h-6 w-6 text-purple-600 dark:text-purple-400 mr-2" />
          <h2 className="text-xl font-semibold text-gray-800 dark:text-gray-200">Upcoming Events</h2>
        </div>
        <div className="text-center py-8">
          <div className="text-red-600 dark:text-red-400 mb-2">Failed to load calendar events</div>
          <div className="text-sm text-gray-500 dark:text-gray-400">{error}</div>
          <button
            onClick={fetchCalendarEvents}
            className="mt-4 px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 transition-colors"
          >
            Retry
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 transition-colors duration-200">
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center">
          <CalendarIcon className="h-6 w-6 text-purple-600 dark:text-purple-400 mr-2" />
          <h2 className="text-xl font-semibold text-gray-800 dark:text-gray-200">Upcoming Events</h2>
        </div>
        <button
          onClick={fetchCalendarEvents}
          className="text-sm text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors"
        >
          Refresh
        </button>
      </div>

      {events.length === 0 ? (
        <div className="text-center py-8">
          <CalendarIcon className="h-12 w-12 text-gray-400 dark:text-gray-600 mx-auto mb-4" />
          <p className="text-gray-500 dark:text-gray-400">No upcoming events</p>
        </div>
      ) : (
        <div className="space-y-4">
          {events.map((event) => (
            <div
              key={`${event.uid}-${event.start.toISOString()}`}
              className="p-4 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            >
              <div className="flex items-start justify-between">
                <div className="flex-1">
                  <h3 className="font-medium text-gray-900 dark:text-white mb-1">
                    {event.summary}
                  </h3>
                  <div className="flex items-center text-sm text-gray-600 dark:text-gray-400 mb-2">
                    <ClockIcon className="h-4 w-4 mr-1" />
                    {formatEventDate(event.start)}
                  </div>
                  {event.location && (
                    <div className="text-sm text-gray-500 dark:text-gray-400 mb-2">
                      📍 {event.location}
                    </div>
                  )}
                  {event.description && (
                    <div className="text-sm text-gray-600 dark:text-gray-400">
                      {event.description.length > 100 
                        ? `${event.description.substring(0, 100)}...` 
                        : event.description}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
