# Copy to `.env.local` (or set in your hosting dashboard for production).
# Every VITE_* value is public and bundled into the browser JavaScript.
# Never put secrets, passwords, or API keys in VITE_* variables.

# --- Backend connection ---
VITE_CONVEX_URL=https://your-convex-backend.example.com
# Optional explicit badge override: production | uat | dev
# VITE_APP_ENV=dev
# Optional Convex Cloud deployment slug treated as UAT (red UAT badge)
# VITE_UAT_DEPLOYMENT=your-uat-slug

# --- Brigade branding (all optional; defaults to generic BRAVO labels) ---
# VITE_BRIGADE_NAME=Alpha
# VITE_BRIGADE_FULL_NAME=Alpha Fire Brigade
# VITE_BRIGADE_SHORT_NAME=Alpha FB
# VITE_BRIGADE_CODE=AFB
# VITE_STATION_NAME=Alpha Fire Station
# VITE_QUICK_APPLIANCES=Pumper,Tanker,FCV

# --- Optional integrations ---
# Fire Danger Rating / EMV conditions API base URL (serves /fdr, /fdr-all, /emv-conditions)
# VITE_FDR_API_URL=https://fdr-api.example.com
# Shared parent domain for cross-app SSO cookie + /sso-refresh.html (disabled when unset)
# VITE_SSO_DOMAIN=example.com

# --- Auth, notifications, kiosk ---
VITE_DISABLE_CAPTCHA=false
# VITE_HCAPTCHA_SITE_KEY=
# VITE_VAPID_PUBLIC_KEY=
# VITE_GATE_API_BASE=
# VITE_GATE_MOCK=true

# --- Optional analytics ---
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=
